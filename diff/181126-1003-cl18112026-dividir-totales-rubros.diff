-
-function esRubroIva(item: RubroTotal, codRubroIVA?: Id | null) {
-  const nombre = String(item.nombre ?? item.gruporubro_nombre ?? "")
-    .trim()
-    .toUpperCase();
-
-  return (
-    (codRubroIVA != null && String(item.cod_rubro) === String(codRubroIVA)) || nombre === "IVA"
