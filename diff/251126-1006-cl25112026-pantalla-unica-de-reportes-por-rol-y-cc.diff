+                    ) : null}
+                  </div>
+                </Panel>
+              </div>
+            </AccordionContent>
+          </AccordionItem>
+        </Accordion>
+      </Panel>
+
+      {/* ── Resumen agrupado ── */}
+      <Panel>
+        <EncabezadoPanel
+          icono={<Table2 />}
+          titulo="Resumen agrupado"
+          subtitulo="Agrupado según «Personaliza tu reporte»"
+        />
+        <div className="p-4">
+          {consulta.isLoading ? (
+            <MensajeVacio>Cargando…</MensajeVacio>
