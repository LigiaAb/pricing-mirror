 const { ahoraGuatemala, fechaHoraValida, FORMATO_SQL } = require("../../utils/rangoFechaGuatemala");
+const dayjs = require("dayjs");
+
+/**
+ * Filtro por usuario. `cod_usuario` se aplica al asignado (`USUARIO_ID`) o al creador
+ * (`USUARIO_CREADOR_ID`) según `tipo_usuario` ("asignado" por defecto). `cod_asesor` y
+ * `cod_creador` filtran directo cada columna.
+ */
+const filtrarPorUsuario = (consulta, campos) => {
+    if(('cod_asesor' in campos)){
+        consulta.where('AC.USUARIO_ID', campos.cod_asesor)
+    }
+    if(('cod_creador' in campos)){
+        consulta.where('AC.USUARIO_CREADOR_ID', campos.cod_creador)
+    }
+    if(('cod_usuario' in campos)){
+        const columna = campos.tipo_usuario === 'creador' ? 'AC.USUARIO_CREADOR_ID' : 'AC.USUARIO_ID'
+        consulta.where(columna, campos.cod_usuario)
+    }
+}
+
+/** Día (YYYY-MM-DD) de una fecha del filtro; error si no es válida. */
+const diaDelFiltro = (valor, campo) => {
+    const fecha = fechaHoraValida(valor)
+    if(!fecha) throw new Error(`La fecha del filtro ${campo} no es válida, verifique`)
+    return fecha.slice(0, 10)
+}
+
+/**
+ * Rango de días (ambos inclusive) sobre ACTIVIDAD_FECHA_PROGRAMACION, en hora de Guatemala.
+ * Compara la columna sin CAST (>= inicio del primer día y < inicio del día siguiente al
+ * último) para que SQL Server pueda usar un índice sobre la fecha.
+ */
+const filtrarPorFechaProgramada = (consulta, campoInicio, campoFin, campos) => {
+    if((campoInicio in campos) && campos[campoInicio] !== ''){
+        consulta.where('AC.ACTIVIDAD_FECHA_PROGRAMACION', '>=', `${diaDelFiltro(campos[campoInicio], campoInicio)}T00:00:00`)
+    }
+    if((campoFin in campos) && campos[campoFin] !== ''){
+        const siguiente = dayjs(diaDelFiltro(campos[campoFin], campoFin)).add(1, 'day').format('YYYY-MM-DD')
+        consulta.where('AC.ACTIVIDAD_FECHA_PROGRAMACION', '<', `${siguiente}T00:00:00`)
+    }
+}
 
