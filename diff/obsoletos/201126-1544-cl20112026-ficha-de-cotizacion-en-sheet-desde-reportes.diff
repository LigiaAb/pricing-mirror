+"use client";
+
+import { format, isValid, parseISO } from "date-fns";
+import {
+  CalendarDays,
+  ClipboardList,
+  FileText,
+  type LucideIcon,
+  Route,
+  SquareArrowOutUpRight,
+  Target,
+} from "lucide-react";
+import Link from "next/link";
+import type * as React from "react";
+import { Button } from "@/shared/components/ui/button";
+import {
+  Sheet,
+  SheetContent,
+  SheetDescription,
+  SheetHeader,
+  SheetTitle,
+} from "@/shared/components/ui/sheet";
+import { encodeId } from "@/shared/lib/sqids";
+import { cn } from "@/shared/lib/utils";
+import type { FilaKpi } from "../api/kpi-cotizaciones";
+
+/**
+ * Ficha de una cotización del reporte (nivel "Cotización" de la tabla dinámica), en un Sheet.
+ * Usa solo los datos que ya trae `report_kpi_cotizaciones` (sin consultas extra) y los
+ * muestra en cards, con el mismo diseño que Información de embarques v2. El botón abre la
+ * cotización en una pestaña nueva (misma ruta que Autorización Spot).
+ */
+export function FichaCotizacionSheet({
+  fila,
+  onOpenChange,
+}: {
+  fila: FilaKpi | null;
+  onOpenChange: (open: boolean) => void;
+}) {
+  return (
+    <Sheet open={fila != null} onOpenChange={onOpenChange}>
+      <SheetContent
+        side="right"
+        className="w-full overflow-y-auto border-l bg-card p-0 sm:max-w-2xl"
+      >
+        <SheetHeader className="border-b bg-muted/40 px-4 py-5 pr-12 sm:px-6 sm:py-6 sm:pr-14">
+          <div className="flex flex-wrap items-start justify-between gap-3">
+            <div className="flex items-start gap-3">
+              <div className="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm">
+                <FileText className="size-5" aria-hidden="true" />
+              </div>
+              <div className="space-y-1">
+                <SheetTitle>Cotización #{fila?.cotizacion ?? ""}</SheetTitle>
+                <SheetDescription>{texto(fila?.cliente) ?? "Sin cliente"}</SheetDescription>
+              </div>
+            </div>
+            {fila ? (
+              <div className="flex flex-wrap items-center gap-2">
+                {texto(fila.estado) ? (
+                  <span className="rounded-full border border-primary/40 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
+                    {texto(fila.estado)}
+                  </span>
+                ) : null}
+                <Button type="button" size="sm" asChild>
+                  <Link
+                    href={`/tarifas/cotizacion/solicitud-cotizacion/${encodeId(Number(fila.cotizacion))}`}
+                    target="_blank"
+                  >
+                    <SquareArrowOutUpRight className="size-4" aria-hidden="true" />
+                    Ver cotización
+                  </Link>
+                </Button>
+              </div>
+            ) : null}
+          </div>
+        </SheetHeader>
+
+        {fila ? (
+          <div className="grid grid-cols-1 gap-4 p-4 sm:p-6 md:grid-cols-2">
+            <CardInfo titulo="General" icono={ClipboardList}>
+              <Datos>
+                <Fila label="Cliente">{texto(fila.cliente) ?? VACIO}</Fila>
+                <Fila label="Cotizó">{nombreUsuario(fila)}</Fila>
+                <Fila label="Departamento">{texto(fila.cc_nombre) ?? VACIO}</Fila>
+                <Fila label="Tipo de pago">{texto(fila.tipo_pago) ?? VACIO}</Fila>
+              </Datos>
+            </CardInfo>
+
+            <CardInfo titulo="Ruta" icono={Route} meta={texto(fila.transporte)}>
+              <p className="flex flex-wrap items-center gap-1 text-sm font-semibold">
+                {lugar(fila.origen_codigo, fila.origen)}
+                <span className="text-muted-foreground" aria-hidden="true">
+                  →
+                </span>
+                {lugar(fila.destino_codigo, fila.destino)}
+              </p>
+              <Datos>
+                <Fila label="Países">
+                  {`${texto(fila.origen_pais) ?? VACIO} → ${texto(fila.destino_pais) ?? VACIO}`}
+                </Fila>
+                <Fila label="Carrier">{texto(fila.carrier) ?? VACIO}</Fila>
+              </Datos>
+            </CardInfo>
+
+            <CardInfo titulo="Fechas" icono={CalendarDays}>
+              <Datos>
+                <Fila label="Creación">{fecha(fila.fecha_creacion)}</Fila>
+                <Fila label="Aprobación">{fecha(fila.fecha_aprobacion)}</Fila>
+              </Datos>
+            </CardInfo>
+
+            <CardInfo titulo="En el periodo" icono={Target}>
+              <Datos>
+                <Fila label="Realizada">{fila.realizada === 1 ? "Sí" : "No"}</Fila>
+                <Fila label="Cerrada">{fila.cerrada === 1 ? "Sí" : "No"}</Fila>
+                {fila.tipo_precio ? (
+                  <Fila label="Precio">{TIPO_PRECIO[fila.tipo_precio]}</Fila>
+                ) : null}
+              </Datos>
+            </CardInfo>
+          </div>
+        ) : null}
+      </SheetContent>
+    </Sheet>
+  );
+}
+
+/* ==========================================================================
+ * DATOS
+ * ========================================================================== */
+
+const VACIO = "—";
+
+const TIPO_PRECIO: Record<NonNullable<FilaKpi["tipo_precio"]>, string> = {
+  SOBRE_TARIFA: "Sobre tarifa",
+  SPOT: "Spot (debajo de tarifa)",
+  TARIFA_PUBLICADA: "Tarifa publicada",
+};
+
+const texto = (valor: string | null | undefined) => valor?.trim() || undefined;
+
+const nombreUsuario = (fila: FilaKpi) =>
+  texto(`${fila.nombres ?? ""} ${fila.apellidos ?? ""}`) ?? `Usuario ${fila.usuario}`;
+
+/** "CÓDIGO - NOMBRE" (o solo el nombre). */
+const lugar = (codigo: string | null | undefined, nombre: string | null | undefined) => {
+  const n = texto(nombre);
+  const c = texto(codigo);
+  if (!n) return VACIO;
+  return c ? `${c} - ${n}` : n;
+};
+
+/** Fecha ISO del reporte → dd/MM/yyyy ("—" si no hay o no es válida). */
+const fecha = (valor: string | null | undefined) => {
+  const t = texto(valor);
+  if (!t) return VACIO;
+  const d = parseISO(t);
+  return isValid(d) ? format(d, "dd/MM/yyyy") : t;
+};
+
+/* ==========================================================================
+ * PIEZAS DE LAS CARDS (mismo diseño que Información de embarques v2)
+ * ========================================================================== */
+
+/** Card con encabezado (icono, título y dato resumen a la derecha). */
+function CardInfo({
+  titulo,
+  icono: Icono,
+  meta,
+  className,
+  children,
+}: {
+  titulo: string;
+  icono: LucideIcon;
+  meta?: string | undefined;
+  className?: string | undefined;
+  children: React.ReactNode;
+}) {
+  return (
+    <section className={cn("flex flex-col overflow-hidden rounded-lg border bg-card", className)}>
+      <header className="flex items-center gap-2 border-b bg-muted/40 px-4 py-2">
+        <span className="flex size-7 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary">
+          <Icono className="size-4" aria-hidden="true" />
+        </span>
+        <h4 className="flex-1 text-sm font-semibold">{titulo}</h4>
+        {meta ? <span className="text-xs text-muted-foreground">{meta}</span> : null}
+      </header>
+      <div className="flex flex-1 flex-col gap-3 px-4 py-3">{children}</div>
+    </section>
+  );
+}
+
+/** Lista etiqueta / valor en dos columnas. */
+function Datos({ children }: { children: React.ReactNode }) {
+  return (
+    <dl className="grid grid-cols-[minmax(6rem,auto)_minmax(0,1fr)] gap-x-3 gap-y-2 text-sm">
+      {children}
+    </dl>
+  );
+}
+
+function Fila({ label, children }: { label: string; children: React.ReactNode }) {
+  return (
+    <>
+      <dt className="pt-0.5 text-xs text-muted-foreground">{label}</dt>
+      <dd className="min-w-0 break-words">{children}</dd>
+    </>
+  );
+}
