+    idFile: "000099",
+    paisDestino: "ESTADOS UNIDOS",
+    clienteCoordinacion: "CAFÉ DE ALTURA",
+    lineaAerea: "AVIANCA",
+  },
+  {
+    correlativoGuiaMaster: "075-67690571",
+    guiaCoordinacion: "CRP-000097",
+    idFile: "000097",
+    paisDestino: "SUIZA",
+    clienteCoordinacion: "NELIXIA S.A.",
+    lineaAerea: "IBERIA",
+  },
+  {
