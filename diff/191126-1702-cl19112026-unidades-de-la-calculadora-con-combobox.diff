+/** Nombre visible de una unidad (el mismo que mostraba el select nativo). */
+function textoUnidad(unidad: Unidad) {
+  return String(unidad.tipo_desc ?? unidad.label ?? unidad.value);
+}
+
+/*
+ * Select buscable de unidades (#165): `ComboboxOpcion`, el estándar para opciones
+ * en memoria. Muestra el mismo texto que el select nativo y devuelve la unidad
+ * original del catálogo, así que el formulario y las filas no cambian.
+ */
+function SelectUnidad({
+  id,
+  label,
+  value,
+  unidades,
+  onChange,
+}: {
+  id: string;
+  label: string;
+  value: Unidad | null;
+  unidades: Unidad[];
+  onChange: (unidad: Unidad | null) => void;
+}) {
+  const opciones = React.useMemo(
+    () => unidades.map((unidad) => ({ value: unidad.value, label: textoUnidad(unidad) })),
+    [unidades],
+  );
+
+  return (
+    <ComboboxOpcion
+      id={id}
+      label={label}
+      value={value == null ? null : { value: value.value, label: textoUnidad(value) }}
+      onChange={(opcion) =>
+        onChange(
+          opcion == null
+            ? null
+            : (unidades.find((unidad) => String(unidad.value) === String(opcion.value)) ?? null),
+        )
+      }
+      options={opciones}
+      clearable={false}
+      portalled={false}
+    />
+  );
+}
+
